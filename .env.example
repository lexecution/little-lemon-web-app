# Optional environment variables. The defaults in littlelemon/settings.py
# already match a local MySQL server (root user, empty password), so you only
# need these if your set-up differs. Export them in your shell, or copy this
# file to `.env` and load it with your tool of choice (`.env` is git-ignored).

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=LittleLemon
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
